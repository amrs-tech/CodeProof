# Copy to .env. Keep credentials out of Git.
CODEPROOF_DATABASE_URL=postgresql://codeproof:codeproof@localhost:5432/codeproof
CODEPROOF_DATA_DIR=data
# auto prefers Gemini when both its key and model are set; otherwise OpenAI-compatible.
CODEPROOF_LLM_PROVIDER=auto
CODEPROOF_LLM_FALLBACK_ENABLED=true
CODEPROOF_LLM_BASE_URL=https://api.openai.com/v1
CODEPROOF_LLM_API_KEY=
CODEPROOF_LLM_MODEL=gpt-6-luna
CODEPROOF_LLM_REASONING_EFFORT=medium
# Native Gemini generateContent API; Live/audio models cannot provide guarded JSON edits.
CODEPROOF_GEMINI_API_KEY=
CODEPROOF_GEMINI_MODEL=gemini-3.8-flash
CODEPROOF_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Optional for local use; required before intentionally exposing beyond loopback.
CODEPROOF_API_TOKEN=
CODEPROOF_MAX_ATTEMPTS=3
CODEPROOF_MAX_TOTAL_ATTEMPTS=12
CODEPROOF_MAX_RUN_SECONDS=300
CODEPROOF_LLM_MAX_CALLS=6
# Run the app natively and build Dockerfile.sandbox to enable behavioral tests.
CODEPROOF_SANDBOX_ENABLED=false
CODEPROOF_SANDBOX_IMAGE=codeproof-sandbox:local
CODEPROOF_SANDBOX_TIMEOUT=60
